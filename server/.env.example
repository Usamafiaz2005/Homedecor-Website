# ==========================================
# HOMEDECOR BACKEND (EXPRESS) - RENDER ENV SPECIFICATION
# ==========================================

# Environment & Server Setup
NODE_ENV=production
PORT=5000

# Database Connection (MongoDB Atlas) - REQUIRED
# Example: mongodb+srv://<user>:<pass>@cluster0.mongodb.net/homedecor?retryWrites=true&w=majority
MONGO_URI=

# Security & Authentication Tokens - REQUIRED
# Generate 64-byte random strings: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Storefront / Frontend CORS Target - REQUIRED
# Supports single URL or comma-separated list of domains
FRONTEND_URL=https://homedecore.homes,https://www.homedecore.homes

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP Notification Credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@homedecore.homes

# JazzCash Payment Gateway (Optional)
JC_MERCHANT_ID=
JC_PASSWORD=
JC_INTEGRITY_SALT=
JC_ENDPOINT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
